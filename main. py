import hashlib
import datetime
import json
import os

DOSSIER = "QG777_BODYCAM"
os.makedirs(DOSSIER, exist_ok=True)

def sceller_preuve(agent, site, action):
    heure = datetime.datetime.now().isoformat()
    data = f"{agent}-{site}-{action}-{heure}-QG777"
    empreinte = hashlib.sha256(data.encode()).hexdigest()
    log = {
        "heure": heure,
        "agent": agent,
        "site": site,
        "action": action,
        "empreinte": f"0x{empreinte[:12]}",
        "hash_complet": empreinte
    }
    with open(f"{DOSSIER}/qg777.log", "a") as f:
        f.write(json.dumps(log) + "\n")
    print(f"[PREUVE SCELLEE] {action} -> {log['empreinte']}")
    return log

if __name__ == "__main__":
    print("=== QG777 BODYCAM SOUVERAINE ===")
    sceller_preuve("QG777", "La Defense", "Ronde_Entree")
    sceller_preuve("QG777", "La Defense", "Controle_Badge")
    sceller_preuve("QG777", "La Defense", "Ronde_Parking")
    sceller_preuve("QG777", "La Defense", "Incident_Scelle")
    sceller_preuve("QG777", "La Defense", "Fin_Service")
